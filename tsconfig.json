{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": [
      "vite/client"
    ],
    "baseUrl": ".",
    "paths": {
      "@futureskill/design-system": [
        "src/index.ts"
      ],
      "@futureskill/design-system/*": [
        "src/*"
      ]
    }
  },
  "include": [
    "src",
    "playground"
  ],
  "exclude": [
    "playground/vite.config.ts"
  ]
}